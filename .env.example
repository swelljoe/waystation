# Use fixture mode for development without credentials.
API_MODE=fixture
WAYSTATION_BIND=0.0.0.0:7777
WAYSTATION_STATIC_DIR=dist

# One shared username and password, as `user:password`, for whoever wants a door
# on a work in progress. Unset, as it is left here and as the hosted demo leaves
# it, the road is open.
# WAYSTATION_GATE=

# Pages other than the one this server hands out that may reach the API, comma
# separated. The demo link is a static GitHub Pages URL with no
# `/api/interpret` of its own, so the game there asks this server instead and the
# browser will not carry that request until this names the page it came from.
# Unset, as here, the server answers only the page it serves itself — which is
# what `make server-live` wants, since both are on the same origin.
# WAYSTATION_ALLOWED_ORIGINS=https://swelljoe.github.io

# Live mode requires the Gloo pair. Gloo is the half that chooses: which need a
# traveler is voicing, and which reviewed passage answers it.
# GLOO_CLIENT_ID=
# GLOO_CLIENT_SECRET=

# Optional. YouVersion supplies the wording, in the player's language. Without a
# key the reviewed English in content/passages.ron is served and labelled
# `reviewed_local`, so the card never credits YouVersion for words it did not
# send. The same key rebuilds content/bible-versions.json via `make bible-versions`.
# YVP_APP_KEY=

# The edition for players whose language has no entry in
# content/bible-versions.json. 3034 is the Berean Standard Bible.
YVP_BIBLE_ID=3034
