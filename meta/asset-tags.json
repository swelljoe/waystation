{
  "schema_version": 1,
  "rules": [
    {
      "patterns": ["motel/*", "horror hotel/*"],
      "tags": ["motel", "hotel", "interior", "exterior", "time fantasy"]
    },
    {
      "patterns": [
        "motel/Auto-tile-A4-walls-*.png",
        "horror hotel/Auto-tile-A4-walls-*.png"
      ],
      "tags": ["wall", "walls", "wallpaper", "panel", "autotile", "interior tile"]
    },
    {
      "patterns": ["motel/tile-B-01.png", "horror hotel/tile-B-01.png"],
      "tags": [
        "door", "window", "bench", "chair", "vending machine", "ice machine",
        "air conditioner", "trash can", "plant", "stairs", "motel sign"
      ]
    },
    {
      "patterns": ["motel/tile-B-02.png", "horror hotel/tile-B-02.png"],
      "tags": [
        "parking", "road", "car", "vehicle", "street light", "curb", "motel sign"
      ]
    },
    {
      "patterns": ["motel/tile-B-03.png", "horror hotel/tile-B-03.png"],
      "tags": [
        "reception", "front desk", "office", "desk", "computer", "telephone",
        "sofa", "couch", "armchair", "coffee table", "furniture", "motel sign"
      ]
    },
    {
      "patterns": ["motel/tile-B-04.png", "horror hotel/tile-B-04.png"],
      "tags": [
        "bed", "bedroom", "nightstand", "table", "chair", "wardrobe", "dresser",
        "television", "tv", "cabinet", "furniture"
      ]
    },
    {
      "patterns": ["motel/tile-B-05.png", "horror hotel/tile-B-05.png"],
      "tags": [
        "bathroom", "toilet", "sink", "shower", "bathtub", "bath", "mirror",
        "shelf", "towel", "cabinet"
      ]
    },
    {
      "patterns": ["Modern_Farm_v1.2/**/*"],
      "tags": ["farm", "cozy", "modern farm"]
    },
    {
      "patterns": ["THE NATURAL/Props/*"],
      "tags": ["nature", "plant", "prop", "outdoor"]
    },
    {
      "patterns": ["THE NATURAL/Icons/*", "Modern_Farm_v1.2/Icons/*"],
      "tags": ["icon", "inventory", "item", "ui"]
    },
    {
      "patterns": ["custom/*"],
      "tags": ["custom", "project authored", "redistributable"]
    }
  ]
}
